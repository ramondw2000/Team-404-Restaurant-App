# Dependencies (reinstalled inside the image)
/vendor
/node_modules

# Build artefacts (regenerated by the assets stage)
/public/build
/public/hot
/public/storage
/.vite

# Local environment & secrets
.env
.env.backup
.env.production

# Local SQLite databases & volatile storage
/database/*.sqlite
/database/*.sqlite-*
/database/data
/storage/app/public/dishes
/storage/app/public/images
/storage/logs/*
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/pail

# VCS & tooling
/.git
/.github
/.idea
/.agents
/.ai
/.codex
/.cursor
/.windsurf
/tests
/_archived
