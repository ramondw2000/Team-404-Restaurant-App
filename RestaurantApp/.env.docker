# ─────────────────────────────────────────────────────────────────────────────
# Docker environment for RestaurantApp.
# This file is external to docker-compose.yml and is loaded via `env_file`.
# Every value below is injected into the container as a real environment
# variable, so Laravel reads it through config()/env() without a baked-in .env.
# Adjust freely — defaults below run the app on SQLite with zero extra services.
# ─────────────────────────────────────────────────────────────────────────────

APP_NAME=RestaurantApp
APP_ENV=local
APP_KEY=base64:cx50zovZRymA73PzhI9iE/0LYri/EifLvezalppjQFI=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_TIMEZONE=Europe/Amsterdam
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Host port published by docker compose (container always serves on 8000).
APP_PORT=8000

# ─── Database ────────────────────────────────────────────────────────────────
# Default: SQLite. The entrypoint creates the file and seeds it on first boot.
# DB_DATABASE must be an absolute path for SQLite; it lives on a named volume
# so data survives container restarts.
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/database/data/database.sqlite

# Set DB_SEED=true to force a fresh migrate + seed on the next boot
# (always happens automatically the first time a SQLite file is created).
DB_SEED=false

# To switch to MySQL instead: set DB_CONNECTION=mysql, fill the values below,
# add a `mysql` service to docker-compose.yml, and set DB_SEED=true once.
# DB_CONNECTION=mysql
# DB_HOST=mysql
# DB_PORT=3306
# DB_DATABASE=restaurantapp
# DB_USERNAME=restaurantapp
# DB_PASSWORD=secret

# ─── Drivers (database-backed, work out of the box on SQLite) ────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=database
CACHE_STORE=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

MAIL_MAILER=log

BCRYPT_ROUNDS=12

TAX_RATE=0.10
